#!/bin/bash
# ==============================
# OpenFOAM Performance-Optimized Run Script
# Features:
# - Advanced RAPL power monitoring
# - Performance metrics collection
# - Automatic core pinning
# - Detailed system profiling
# - CSV and JSON output for analysis
# ==============================

set -euo pipefail

# Load OpenFOAM environment
export WM_PROJECT_SITE="${WM_PROJECT_SITE:-}"
source /home/charles/OpenFOAM/OpenFOAM-v2412/etc/bashrc

# Default configuration
: ${SLURM_NTASKS:=4}  # Default to 4 MPI tasks if not set
: ${OMP_NUM_THREADS:=1}  # Default to 1 thread per MPI task
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
OUTDIR="results/run_$TIMESTAMP"
RAPL_INTERVAL=0.1  # More frequent sampling for better accuracy
HOSTNAME=$(hostname)

# Performance tuning parameters
export OMP_PROC_BIND=close
export OMP_PLACES=cores
export KMP_AFFINITY=compact,1,0,granularity=fine
export UCX_NET_DEVICES=all  # For better MPI communication

# Create output directory
mkdir -p "$OUTDIR"
echo "Running OpenFOAM case. Outputs will be in $OUTDIR"

# System information
{
    echo "=== System Information ==="
    lscpu
    echo -e "\n=== Memory Info ==="
    free -h
    echo -e "\n=== OpenFOAM Version ==="
    simpleFoam -version 2>&1
    echo -e "\n=== MPI Version ==="
    mpirun --version
} > "$OUTDIR/system_info.txt"

# Copy case files (exclude unnecessary files)
rsync -a --exclude 'processor*' --exclude '*.log' --exclude '*.csv' --exclude '*.out' ./ "$OUTDIR/"
cd "$OUTDIR" || exit 1

# Generate optimized decomposeParDict
cat > system/decomposeParDict <<EOF
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
numberOfSubdomains $SLURM_NTASKS;
method          scotch;  // Best for most cases, alternatives: hierarchical, metis

// Advanced decomposition settings
coeffs
{
    // Optimize for minimal processor boundaries
    processorWeights (1);
    // Tune for your specific hardware
    cacheCoherent   0.8;
    // Memory saving mode
    memory          low;
}
EOF

# Decompose mesh with performance logging
{
    echo "=== Mesh Decomposition ==="
    echo "Start time: $(date)"
    /usr/bin/time -v decomposePar -force 2>&1
    echo -e "\nDecomposition complete at: $(date)"
} > "$OUTDIR/decompose.log" 2>&1

# -----------------------------
# Performance Monitoring Setup
# -----------------------------
start_monitoring() {
    # CPU frequency monitoring
    cpufreq-info > "$OUTDIR/cpufreq_start.log"
    
    # RAPL power monitoring
    RAPL_FILE="/sys/class/powercap/intel-rapl/intel-rapl:0/energy_uj"
    if [ -f "$RAPL_FILE" ]; then
        {
            echo "timestamp,energy_uj"
            while true; do
                echo "$(date +%s.%N),$(cat "$RAPL_FILE" 2>/dev/null || echo 0)"
                sleep "$RAPL_INTERVAL"
            done
        } > "$OUTDIR/power_rapl.csv" &
        RAPL_PID=$!
    fi
    
    # System monitoring
    {
        echo "timestamp,%usr,%sys,%iowait,%idle"
        mpstat -P ALL 1 | stdbuf -oL grep -v "Average" | stdbuf -oL grep -v "CPU" | stdbuf -oL awk '/^[0-9]/ {print systime()","$3","$5","$6","$12}'
    } > "$OUTDIR/cpu_usage.csv" &
    CPU_PID=$!
    
    # Memory monitoring
    {
        echo "timestamp,used,free,buffers,cached"
        while true; do
            free -k | awk 'NR==2{print systime()","$3","$4","$6","$7}'
            sleep 1
        done
    } > "$OUTDIR/memory_usage.csv" &
    MEM_PID=$!
}

stop_monitoring() {
    kill "$RAPL_PID" 2>/dev/null
    kill "$CPU_PID" 2>/dev/null
    kill "$MEM_PID" 2>/dev/null
    wait 2>/dev/null
    cpufreq-info > "$OUTDIR/cpufreq_end.log"
}

# -----------------------------
# Run Simulation with Performance Monitoring
# -----------------------------
echo "=== Starting Simulation ==="
start_monitoring
START_TIME=$(date +%s.%N)

# Run with optimized MPI settings
mpirun -np $SLURM_NTASKS \
    --bind-to core \
    --map-by socket:PE=$OMP_NUM_THREADS \
    -x OMP_NUM_THREADS \
    -x OMP_PROC_BIND \
    -x OMP_PLACES \
    -x KMP_AFFINITY \
    simpleFoam -parallel > "$OUTDIR/foam.out" 2>&1

END_TIME=$(date +%s.%N)
stop_monitoring
ELAPSED=$(echo "$END_TIME - $START_TIME" | bc)

# -----------------------------
# Performance Analysis
# -----------------------------
# Calculate energy usage
if [ -f "$OUTDIR/power_rapl.csv" ]; then
    START_ENERGY=$(head -n 2 "$OUTDIR/power_rapl.csv" | tail -1 | cut -d',' -f2)
    END_ENERGY=$(tail -n 1 "$OUTDIR/power_rapl.csv" | cut -d',' -f2)
    ENERGY_J=$(echo "scale=2; ($END_ENERGY - $START_ENERGY) / 1000000" | bc)
else
    ENERGY_J=0
fi

# Performance metrics
ITERATIONS=$(grep -c "Time =" "$OUTDIR/foam.out")
AVG_POWER_W=$(echo "scale=2; $ENERGY_J / $ELAPSED" | bc)
EFFICIENCY=$(echo "scale=6; $ITERATIONS / $ENERGY_J" | bc)

# System load
CPU_AVG=$(mpstat 1 1 | awk 'END{print 100 - $NF}')
MEM_USED=$(free -m | awk 'NR==2{print $3}')

# -----------------------------
# Generate Reports
# -----------------------------
# JSON report for easy parsing
cat > "$OUTDIR/performance_report.json" <<EOF
{
    "metadata": {
        "hostname": "$HOSTNAME",
        "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
        "mpi_tasks": $SLURM_NTASKS,
        "omp_threads": $OMP_NUM_THREADS,
        "openfoam_version": "$(simpleFoam -version 2>&1 | head -1)"
    },
    "performance": {
        "elapsed_time": $ELAPSED,
        "iterations": $ITERATIONS,
        "iterations_per_second": $(echo "scale=2; $ITERATIONS / $ELAPSED" | bc),
        "energy_consumed_j": $ENERGY_J,
        "average_power_w": $AVG_POWER_W,
        "efficiency_iter_per_j": $EFFICIENCY,
        "cpu_utilization": $CPU_AVG,
        "memory_used_mb": $MEM_USED
    }
}
EOF

# Human-readable summary
cat > "$OUTDIR/summary.txt" <<EOF
=== OpenFOAM Performance Run Summary ===
Timestamp:       $(date)
Host:            $HOSTNAME
MPI Tasks:       $SLURM_NTASKS
OMP Threads:     $OMP_NUM_THREADS
Elapsed Time:    $(printf "%.2f" $ELAPSED) seconds
Iterations:      $ITERATIONS
Iterations/s:    $(echo "scale=2; $ITERATIONS / $ELAPSED" | bc)
Energy:          $ENERGY_J J
Avg. Power:      $AVG_POWER_W W
Efficiency:      $EFFICIENCY it/J
CPU Utilization: $CPU_AVG%
Memory Used:     $MEM_USED MB

=== Files Generated ===
- performance_report.json: Complete metrics in JSON format
- power_rapl.csv: Power consumption over time
- cpu_usage.csv: CPU utilization statistics
- memory_usage.csv: Memory usage over time
- foam.out: OpenFOAM solver output
- system_info.txt: System configuration
- decompose.log: Mesh decomposition details

=== Performance Tips ===
1. For better performance, try adjusting:
   - Number of MPI tasks vs OpenMP threads
   - Decomposition method in system/decomposeParDict
   - Solver settings in system/fvSolution
2. Check cpu_usage.csv for potential load imbalance
3. Monitor memory_usage.csv for memory bottlenecks

Run completed successfully in $OUTDIR
EOF

# Print summary to console
cat "$OUTDIR/summary.txt"

# Clean up temporary files
rm -f "$OUTDIR/processor*" 2>/dev/null || true
