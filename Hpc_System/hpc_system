#!/usr/bin/env bash
#
# hpc-cluster-stats.sh
# Comprehensive HPC cluster information gathering script.
# Collects hardware specs, cluster config, scheduler info, and performance stats.
# Works on typical Linux HPC systems (CHPC, compute clusters with Slurm).
#
# Usage: ./hpc-cluster-stats.sh [--verbose] [--output FILE]

set -o nounset
set -o pipefail
# removed errexit to prevent script from stopping on small parsing errors

VERBOSE=0
OUTPUT_FILE=""

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --verbose|-v)
      VERBOSE=1
      shift
      ;;
    --output|-o)
      OUTPUT_FILE="$2"
      shift 2
      ;;
    --help|-h)
      echo "Usage: $0 [--verbose] [--output FILE]"
      echo "  --verbose, -v    Show detailed output"
      echo "  --output, -o     Save output to file"
      echo "  --help, -h       Show this help message"
      exit 0
      ;;
    *)
      shift
      ;;
  esac
done

# ---- Color output ----
if [ -t 1 ]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  BLUE='\033[0;34m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  NC='\033[0m' # No Color
else
  RED=''
  GREEN=''
  YELLOW=''
  BLUE=''
  CYAN=''
  BOLD=''
  NC=''
fi

# ---- Helpers ----
human_bytes() {
  local bytes=$1
  if [ "$bytes" -lt 1024 ]; then
    printf "%dB" "$bytes"
  elif [ "$bytes" -lt $((1024**2)) ]; then
    awk -v b=$bytes 'BEGIN {printf "%.1fK", b/1024}'
  elif [ "$bytes" -lt $((1024**3)) ]; then
    awk -v b=$bytes 'BEGIN {printf "%.1fM", b/(1024^2)}'
  else
    awk -v b=$bytes 'BEGIN {printf "%.1fG", b/(1024^3)}'
  fi
}

print_header() {
  printf "\n${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
  printf "${BOLD}${CYAN}▶ %s${NC}\n" "$1"
  printf "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
}

print_subheader() {
  printf "\n${BOLD}${YELLOW}■ %s${NC}\n" "$1"
}

print_info() {
  printf "  ${GREEN}%-30s${NC} %s\n" "$1:" "$2"
}

print_warning() {
  printf "  ${YELLOW}⚠ %s${NC}\n" "$1"
}

print_error() {
  printf "  ${RED}✗ %s${NC}\n" "$1"
}

print_success() {
  printf "  ${GREEN}✓ %s${NC}\n" "$1"
}

safe_cmd() {
  if command -v "$1" >/dev/null 2>&1; then
    return 0
  else
    return 1
  fi
}

# ============================================================================
# SYSTEM IDENTIFICATION
# ============================================================================
system_identification() {
  print_header "SYSTEM IDENTIFICATION"
  
  print_info "Hostname" "$(hostname -f 2>/dev/null || hostname)"
  print_info "Current User" "$(whoami)"
  print_info "Current Date" "$(date '+%Y-%m-%d %H:%M:%S %Z')"
  
  if [ -f /etc/os-release ]; then
    . /etc/os-release
    print_info "OS Distribution" "${PRETTY_NAME:-N/A}"
    print_info "OS Version" "${VERSION:-N/A}"
  fi
  
  if safe_cmd uname; then
    print_info "Kernel" "$(uname -r)"
    print_info "Architecture" "$(uname -m)"
  fi
  
  if safe_cmd uptime; then
    print_info "Uptime" "$(uptime -p 2>/dev/null || uptime)"
    print_info "Load Average" "$(cat /proc/loadavg 2>/dev/null | cut -d' ' -f1-3)"
  fi
}

# ============================================================================
# CPU INFORMATION
# ============================================================================
cpu_information() {
  print_header "CPU INFORMATION"
  
  if [ -f /proc/cpuinfo ]; then
    local model=$(grep "model name" /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)
    local physical_cpus=$(grep "physical id" /proc/cpuinfo | sort -u | wc -l)
    local cores=$(grep "cpu cores" /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)
    local logical_cpus=$(grep "processor" /proc/cpuinfo | wc -l)
    local flags=$(grep "flags" /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)
    
    print_info "CPU Model" "${model:-N/A}"
    print_info "Physical CPUs" "${physical_cpus:-N/A}"
    print_info "Cores per CPU" "${cores:-N/A}"
    print_info "Logical CPUs (threads)" "${logical_cpus:-N/A}"
    print_info "Total Cores" "$((physical_cpus * cores))"
    
    # Check for specific features
    if echo "$flags" | grep -q "avx2"; then print_success "AVX2 supported"; fi
    if echo "$flags" | grep -q "avx512"; then print_success "AVX-512 supported"; fi
    if echo "$flags" | grep -q "sse4_2"; then print_success "SSE4.2 supported"; fi
    
    # CPU frequency
    if [ -f /proc/cpuinfo ]; then
      local cpu_mhz=$(grep "cpu MHz" /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)
      print_info "Current CPU Frequency" "${cpu_mhz} MHz"
    fi
    
    # CPU scaling governor
    if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
      local governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)
      print_info "CPU Governor" "$governor"
    fi
  fi
  
  # lscpu if available
  if safe_cmd lscpu; then
    print_subheader "Detailed CPU Info (lscpu)"
    lscpu | while IFS=: read -r key value; do
      printf "  %-30s %s\n" "$key" "$value"
    done
  fi
  
  # NUMA information
  if safe_cmd numactl; then
    print_subheader "NUMA Configuration"
    numactl --hardware 2>/dev/null || print_warning "NUMA info not available"
  fi
  
  # CPU usage
  print_subheader "CPU Usage (current)"
  local cpu1 cpu2
  cpu1=($(awk '/^cpu /{for(i=2;i<=NF;i++) printf "%s ", $i; print ""}' /proc/stat))
  sleep 0.5
  cpu2=($(awk '/^cpu /{for(i=2;i<=NF;i++) printf "%s ", $i; print ""}' /proc/stat))

  local -i i idle1=0 idle2=0 total1=0 total2=0
  for ((i=0;i<${#cpu1[@]};i++)); do
    total1+=${cpu1[i]}
    total2+=${cpu2[i]}
  done
  idle1=$((cpu1[3] + cpu1[4]))
  idle2=$((cpu2[3] + cpu2[4]))

  local -i total_diff=$((total2 - total1))
  local -i idle_diff=$((idle2 - idle1))
  if [ "$total_diff" -gt 0 ]; then
    local usage=$(awk -v t=$total_diff -v i=$idle_diff 'BEGIN {printf "%.1f", 100 * (t - i) / t}')
    print_info "CPU Usage" "${usage}%"
  fi
}

# ============================================================================
# MEMORY INFORMATION
# ============================================================================
memory_information() {
  print_header "MEMORY INFORMATION"
  
  if safe_cmd free; then
    local mem_total=$(free -b | awk '/^Mem:/ {print $2}')
    local mem_available=$(free -b | awk '/^Mem:/ {print $7}')
    local mem_used=$((mem_total - mem_available))
    local mem_perc=$(awk -v used=$mem_used -v total=$mem_total 'BEGIN {printf "%.1f", 100 * used / total}')
    
    print_info "Total Memory" "$(human_bytes "$mem_total")"
    print_info "Used Memory" "$(human_bytes "$mem_used")"
    print_info "Available Memory" "$(human_bytes "$mem_available")"
    print_info "Memory Usage" "${mem_perc}%"
    
    # Swap
    local swap_total=$(free -b | awk '/^Swap:/ {print $2}')
    local swap_used=$(free -b | awk '/^Swap:/ {print $3}')
    if [ "$swap_total" -gt 0 ]; then
      print_info "Total Swap" "$(human_bytes "$swap_total")"
      print_info "Used Swap" "$(human_bytes "$swap_used")"
    fi
  fi
  
  # Memory details from dmidecode (requires root)
  if safe_cmd dmidecode && [ "$(id -u)" -eq 0 ]; then
    print_subheader "Memory Hardware Details"
    dmidecode -t memory | grep -E "Size:|Speed:|Type:|Manufacturer:" | head -20
  elif safe_cmd dmidecode; then
    print_warning "Run as root to see detailed memory hardware info (dmidecode)"
  fi
  
  # Memory info from /proc/meminfo
  if [ "$VERBOSE" -eq 1 ] && [ -f /proc/meminfo ]; then
    print_subheader "Detailed Memory Info (/proc/meminfo)"
    head -20 /proc/meminfo | while IFS=: read -r key value; do
      printf "  %-30s %s\n" "$key" "$value"
    done
  fi
}

# ============================================================================
# GPU INFORMATION
# ============================================================================
gpu_information() {
  print_header "GPU INFORMATION"
  
  local gpu_found=0
  
  # NVIDIA GPUs
  if safe_cmd nvidia-smi; then
    print_subheader "NVIDIA GPUs"
    nvidia-smi --query-gpu=index,name,driver_version,memory.total,compute_cap --format=csv,noheader | while IFS=, read -r idx name driver mem cap; do
      print_info "GPU $idx" "$name"
      print_info "  Driver Version" "$driver"
      print_info "  Memory" "$mem"
      print_info "  Compute Capability" "$cap"
    done
    gpu_found=1
    
    if [ "$VERBOSE" -eq 1 ]; then
      printf "\n"
      nvidia-smi
    fi
  fi
  
  # AMD GPUs
  if safe_cmd rocm-smi; then
    print_subheader "AMD GPUs"
    rocm-smi --showhw 2>/dev/null || rocm-smi
    gpu_found=1
  fi
  
  # Generic lspci check
  if safe_cmd lspci; then
    local gpu_devices=$(lspci | grep -iE "vga|3d|display|nvidia|amd" | grep -v "Audio")
    if [ -n "$gpu_devices" ]; then
      print_subheader "PCI GPU Devices"
      echo "$gpu_devices" | while read -r line; do
        printf "  %s\n" "$line"
      done
      gpu_found=1
    fi
  fi
  
  if [ "$gpu_found" -eq 0 ]; then
    print_warning "No GPU detected or tools not available"
  fi
}

# ============================================================================
# STORAGE INFORMATION
# ============================================================================
storage_information() {
  print_header "STORAGE INFORMATION"
  
  if safe_cmd df; then
    print_subheader "Filesystem Usage"
    df -h -x tmpfs -x devtmpfs 2>/dev/null | awk 'NR==1 {printf "  %-20s %10s %10s %10s %6s %s\n", "Filesystem", "Size", "Used", "Avail", "Use%", "Mounted"} NR>1 {printf "  %-20s %10s %10s %10s %6s %s\n", $1, $2, $3, $4, $5, $6}'
  fi
  
  # Disk devices
  if safe_cmd lsblk; then
    print_subheader "Block Devices"
    lsblk -o NAME,SIZE,TYPE,MOUNTPOINT,FSTYPE,MODEL 2>/dev/null || lsblk
  fi
  
  # Disk performance (brief)
  if safe_cmd iostat; then
    print_subheader "Disk I/O Stats"
    iostat -x 1 2 | tail -n +4
  fi
  
  # Check for parallel filesystems
  print_subheader "Parallel/Network Filesystems"
  if mount | grep -qE "lustre|gpfs|beegfs|nfs"; then
    mount | grep -E "lustre|gpfs|beegfs|nfs" | while read -r line; do
      printf "  %s\n" "$line"
    done
  else
    print_warning "No Lustre/GPFS/BeeGFS/NFS mounts detected"
  fi
}

# ============================================================================
# NETWORK INFORMATION
# ============================================================================
network_information() {
  print_header "NETWORK INFORMATION"
  
  # Network interfaces
  if safe_cmd ip; then
    print_subheader "Network Interfaces"
    ip -br addr show | awk '{printf "  %-15s %-10s %s\n", $1, $2, $3}'
  elif safe_cmd ifconfig; then
    print_subheader "Network Interfaces (ifconfig)"
    ifconfig | grep -E "^[a-z]|inet " | head -20
  fi
  
  # InfiniBand
  if safe_cmd ibstat; then
    print_subheader "InfiniBand Adapters"
    ibstat 2>/dev/null | grep -E "CA type|Number of ports|State|Physical state|Rate" | head -20
  elif [ -d /sys/class/infiniband ]; then
    print_subheader "InfiniBand Devices"
    ls /sys/class/infiniband/ | while read -r dev; do
      print_info "Device" "$dev"
    done
  fi
  
  # Network performance
  if safe_cmd ethtool && [ "$VERBOSE" -eq 1 ]; then
    print_subheader "Network Interface Details"
    ip -br link show | awk '{print $1}' | while read -r iface; do
      if [ "$iface" != "lo" ]; then
        printf "\n  Interface: %s\n" "$iface"
        ethtool "$iface" 2>/dev/null | grep -E "Speed:|Duplex:|Link detected:" | sed 's/^/    /'
      fi
    done
  fi
}

# ============================================================================
# SLURM / SCHEDULER INFORMATION
# ============================================================================
slurm_information() {
  print_header "HPC SCHEDULER INFORMATION"
  
  if safe_cmd sinfo; then
    print_subheader "Slurm Cluster State"
    sinfo 2>/dev/null || print_warning "Cannot access Slurm info"
    
    print_subheader "Slurm Partitions"
    sinfo -O partitionname,nodes,cpus,memory,time,nodelist 2>/dev/null || true
    
    print_subheader "Slurm Node Details"
    sinfo -N -l 2>/dev/null | head -20 || true
    
    if safe_cmd squeue; then
      print_subheader "Running Jobs"
      local job_count=$(squeue -u "$USER" 2>/dev/null | wc -l)
      print_info "Your Jobs" "$((job_count - 1))"
      
      if [ "$VERBOSE" -eq 1 ]; then
        squeue -u "$USER" 2>/dev/null || true
      fi
    fi
    
    if safe_cmd sacctmgr; then
      print_subheader "Account Information"
      sacctmgr show user "$USER" withassoc format=user,account,partition,qos -P 2>/dev/null | column -t -s'|' || true
    fi
  elif safe_cmd pbsnodes; then
    print_subheader "PBS/Torque Cluster"
    pbsnodes -a | head -50
  else
    print_warning "No scheduler (Slurm/PBS) detected or not accessible"
  fi
}

# ============================================================================
# SOFTWARE ENVIRONMENT
# ============================================================================
software_environment() {
  print_header "SOFTWARE ENVIRONMENT"
  
  # Module system
  if safe_cmd module; then
    print_subheader "Environment Modules"
    print_info "Module System" "Available"
    
    if [ "$VERBOSE" -eq 1 ]; then
      printf "\n  Loaded Modules:\n"
      module list 2>&1 | grep -v "Currently Loaded" | sed 's/^/    /'
      
      printf "\n  Available Modules (sample):\n"
      module avail 2>&1 | head -30 | sed 's/^/    /'
    else
      local loaded_count=$(module list 2>&1 | grep -c "/" || echo "0")
      print_info "Loaded Modules" "$loaded_count"
    fi
  fi
  
  # Compilers
  print_subheader "Compilers"
  if safe_cmd gcc; then
    print_info "GCC" "$(gcc --version | head -1 | cut -d' ' -f3-)"
  fi
  if safe_cmd icc; then
    print_info "Intel C" "$(icc --version | head -1 | cut -d' ' -f3-)"
  fi
  if safe_cmd icpc; then
    print_info "Intel C++" "$(icpc --version | head -1 | cut -d' ' -f3-)"
  fi
  if safe_cmd ifort; then
    print_info "Intel Fortran" "$(ifort --version | head -1 | cut -d' ' -f3-)"
  fi
  if safe_cmd gfortran; then
    print_info "GNU Fortran" "$(gfortran --version | head -1 | cut -d' ' -f4-)"
  fi
  
  # MPI
  print_subheader "MPI Implementations"
  if safe_cmd mpirun; then
    local mpi_version=$(mpirun --version 2>&1 | head -1)
    print_info "MPI" "$mpi_version"
  fi
  if safe_cmd mpicc; then
    print_info "MPI C Compiler" "$(which mpicc)"
  fi
  
  # Math libraries
  print_subheader "Math Libraries"
  if [ -d "$MKLROOT" ] || [ -n "${MKLROOT:-}" ]; then
    print_info "Intel MKL" "${MKLROOT:-Detected}"
  fi
  if ldconfig -p 2>/dev/null | grep -q "openblas"; then
    print_info "OpenBLAS" "Available in system"
  fi
  if ldconfig -p 2>/dev/null | grep -q "liblapack"; then
    print_info "LAPACK" "Available in system"
  fi
  
  # Python
  if safe_cmd python3; then
    print_info "Python3" "$(python3 --version | cut -d' ' -f2)"
  fi
  if safe_cmd python; then
    print_info "Python" "$(python --version 2>&1 | cut -d' ' -f2)"
  fi
}

# ============================================================================
# PROCESS INFORMATION
# ============================================================================
process_information() {
  print_header "PROCESS INFORMATION"
  
  if safe_cmd ps; then
    local total_procs=$(ps aux | wc -l)
    local user_procs=$(ps -u "$USER" | wc -l)
    
    print_info "Total Processes" "$total_procs"
    print_info "Your Processes" "$user_procs"
    
    print_subheader "Top 10 Processes by CPU"
    ps aux --sort=-%cpu | awk 'NR==1 {printf "  %-8s %-10s %6s %6s %s\n", "USER", "PID", "%CPU", "%MEM", "COMMAND"} NR>1 && NR<=11 {printf "  %-8s %-10s %6s %6s %s\n", $1, $2, $3, $4, substr($0,index($0,$11))}'
    
    print_subheader "Top 10 Processes by Memory"
    ps aux --sort=-%mem | awk 'NR==1 {printf "  %-8s %-10s %6s %6s %s\n", "USER", "PID", "%CPU", "%MEM", "COMMAND"} NR>1 && NR<=11 {printf "  %-8s %-10s %6s %6s %s\n", $1, $2, $3, $4, substr($0,index($0,$11))}'
  fi
}

# ============================================================================
# SECURITY & ACCESS
# ============================================================================
security_information() {
  print_header "SECURITY & ACCESS"
  
  if safe_cmd who; then
    local logged_users=$(who | wc -l)
    print_info "Logged in users" "$logged_users"
    
    if [ "$VERBOSE" -eq 1 ]; then
      printf "\n"
      who | sed 's/^/  /'
    fi
  fi
  
  if safe_cmd last; then
    print_subheader "Recent Logins (last 10)"
    last -n 10 -w | head -11 | sed 's/^/  /'
  fi
  
  if [ -r /var/log/auth.log ]; then
    local fails=$(grep -i "failed password" /var/log/auth.log 2>/dev/null | tail -n20 | wc -l)
    print_info "Recent auth failures" "$fails (last 20 entries)"
  fi
  
  # SSH config
  if [ -f ~/.ssh/config ]; then
    print_info "SSH config" "Present (~/.ssh/config)"
  fi
}

# ============================================================================
# CLUSTER TOPOLOGY
# ============================================================================
cluster_topology() {
  print_header "CLUSTER TOPOLOGY"
  
  # Try to detect head/compute node
  if safe_cmd scontrol; then
    local this_node=$(hostname -s)
    if scontrol show node "$this_node" &>/dev/null; then
      print_info "Node Type" "Compute Node"
      scontrol show node "$this_node" 2>/dev/null | grep -E "NodeName|State|CPUTot|RealMemory|Features" | sed 's/^/  /'
    else
      print_info "Node Type" "Login/Head Node (likely)"
    fi
  fi
  
  # Available compute nodes
  if safe_cmd sinfo; then
    print_subheader "Cluster Nodes Summary"
    sinfo -N -o "%.15N %.10T %.4c %.8m %.20f" 2>/dev/null | head -20 || true
  fi
}

# ============================================================================
# BENCHMARK TOOLS
# ============================================================================
benchmark_tools() {
  print_header "BENCHMARK TOOLS AVAILABLE"
  
  local tools=(
    "hpl:HPL (Linpack)"
    "openfoam:OpenFOAM"
    "fluent:ANSYS Fluent"
    "stream:STREAM"
    "iperf:iperf (network)"
    "iperf3:iperf3 (network)"
    "fio:FIO (disk I/O)"
    "stress:stress"
    "stress-ng:stress-ng"
  )
  
  for tool_info in "${tools[@]}"; do
    IFS=: read -r cmd name <<< "$tool_info"
    if safe_cmd "$cmd"; then
      print_success "$name - $(which $cmd)"
    else
      print_warning "$name - not found"
    fi
  done
}

# ============================================================================
# SUMMARY
# ============================================================================
generate_summary() {
  print_header "QUICK SUMMARY"
  
  local hostname=$(hostname -f 2>/dev/null || hostname)
  local cpus=$(grep -c processor /proc/cpuinfo 2>/dev/null || echo "N/A")
  local mem_gb=$(free -g | awk '/^Mem:/ {print $2}')
  local os=$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')
  
  printf "\n"
  printf "  ${BOLD}Hostname:${NC}     %s\n" "$hostname"
  printf "  ${BOLD}OS:${NC}           %s\n" "$os"
  printf "  ${BOLD}CPUs:${NC}         %s logical cores\n" "$cpus"
  printf "  ${BOLD}Memory:${NC}       %s GB\n" "$mem_gb"
  
  if safe_cmd sinfo; then
    local node_count=$(sinfo -N 2>/dev/null | tail -n +2 | wc -l)
    printf "  ${BOLD}Cluster Nodes:${NC} %s\n" "$node_count"
  fi
  
  printf "\n"
}

# ============================================================================
# MAIN
# ============================================================================
main() {
  local start_time=$(date +%s)
  
  {
    printf "${BOLD}${BLUE}"
    cat << "EOF"
╔═══════════════════════════════════════════════════════════════╗
║                                                               ║
║        HPC CLUSTER INFORMATION GATHERING TOOL                 ║
║        Debug Thugs - CHPC Student Cluster Competition         ║
║                                                               ║
╚═══════════════════════════════════════════════════════════════╝
EOF
    printf "${NC}\n"
    
    system_identification
    generate_summary
    cpu_information
    memory_information
    gpu_information
    storage_information
    network_information
    slurm_information
    software_environment
    cluster_topology
    benchmark_tools
    process_information
    security_information
    
    local end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    printf "\n${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
    printf "${BOLD}Report generated in %s seconds${NC}\n" "$duration"
    printf "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
    
  } | if [ -n "$OUTPUT_FILE" ]; then
    tee "$OUTPUT_FILE"
    printf "\n${GREEN}Output saved to: %s${NC}\n" "$OUTPUT_FILE"
  else
    cat
  fi
}

main "$@"

